# Copy to .env and edit. Only AUDIO_DIR is required.

# Directory holding the recordings. File names in the COCO export are resolved
# below it, so <AUDIO_DIR>/<file_name> must exist for every annotated file.
AUDIO_DIR=/path/to/recordings

# Where training output goes on the host: runs, checkpoints and logs.
#RUNS_DIR=./runs

# GPU to train on.
#GPU_ID=0

# Shared memory for the dataloader
#SHM_SIZE=4gb

# TensorBoard port on the host, published on loopback only.
#TENSORBOARD_PORT=6006
