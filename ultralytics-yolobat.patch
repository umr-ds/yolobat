+            eps = float(getattr(self.hyp, "general_smoothing_eps", 0.0))
+            self.smoothing_M = self._build_uniform_smoothing_matrix(self.nc, eps=eps).to(device)
+
+    def _sister_groups(self):
+        """Species whose calls are hard to tell apart, plus singletons for the rest.
+
+        Taken from hyp.smoothing_groups when the training pipeline supplies one
+        (yolobat reads files/taxonomy.yaml); the European species below are the
+        fallback, so older configs keep training as before.
+        """
+        groups = getattr(self.hyp, "smoothing_groups", None)
+        if groups:
+            return [list(group) for group in groups]
+        return [
+            ["Ppip", "Ppyg", "Pnat"],
+            ["Bbar"],
+            ["Rfer", "Rhip"],
+            ["Plecotus"],
+            ["Malc", "Mema", "Mdas", "Mbart", "Mbec", "Mdau", "Mmyo", "Mnat"],
+            ["Eser", "Nlei", "Nnoc"],
+            ["social-call"],
+            ["feeding-buzz"],
+        ]
+
+    def _build_smoothing_matrix(self, sister_groups, names, eps=0.08):
+        """M[c,c] = 1-eps, with eps split evenly over c's sisters. Rows sum to 1."""
+        labels = [names[i] for i in sorted(names)] if isinstance(names, dict) else list(names)
+        name_to_idx = {n: i for i, n in enumerate(labels)}
+        nc = len(labels)
+
+        M = torch.eye(nc)
+        for group in sister_groups:
+            # a class the dataset does not have is simply not smoothed towards
+            idxs = [name_to_idx[n] for n in group if n in name_to_idx]
+            if len(idxs) < 2:
+                continue
+            for c in idxs:
+                sisters = [j for j in idxs if j != c]
+                M[c, c] = 1 - eps
+                M[c, sisters] = eps / len(sisters)
+        return M
+
+    def _build_uniform_smoothing_matrix(self, nc: int, eps: float = 0.05) -> torch.Tensor:
+        """Same, but spread over all classes instead of sisters."""
+        M = torch.full((nc, nc), eps / (nc - 1))
+        M.fill_diagonal_(1 - eps)
+        return M
+
